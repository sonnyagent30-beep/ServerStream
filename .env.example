# ServerStream configuration
# Copy to .env and edit. NEVER commit your real .env.

# Hostname or IP that OBS connects to (your domain, or a bare IP).
# A domain gives you RTMPS ingest on a trusted cert; an IP works but needs OBS
# to skip certificate verification.
PUBLIC_HOST=stream.example.com

# Stream key OBS must send. This doubles as the RTMP stream name, so anyone who
# knows it can push to your server. deploy.sh generates a random one for you.
STREAM_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- dashboard auth
# Both values are REQUIRED for any deployment on a public IP. Without them the
# dashboard is open and every platform stream key is readable over the API.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- standby slate
# Seconds of standby before ServerStream closes the platform feeds when the live
# source disappears. During that window viewers see the standby image instead of
# a frozen frame. 0 disables standby entirely (platform feeds die immediately).
# Set to 0 on a 24/7 channel; 120 is right for most services.
STANDBY_SECONDS=120
